@startuml vista-logica
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam wrapWidth 220
title Vista lógica (4+1)\nEntidades, casos de uso y puertos que existen. Las clases en rosa no tienen flujo que las use.

package "shared-kernel" #EAF3DE {
  interface UserQueryPort {
    +findById(userId): Optional<UserSummary>
  }
  interface DoctorQueryPort {
    +existsById(doctorId): boolean
    +findById(doctorId): Optional<DoctorSummary>
  }
  class UserSummary <<record>> {
    +id: Long
    +fullName: String
    +documentNumber: String
  }
  class DoctorSummary <<record>> {
    +id: Long
    +fullName: String
    +specialty: String
  }
  class DomainException {
    +code: String
  }
  UserQueryPort ..> UserSummary
  DoctorQueryPort ..> DoctorSummary
}

package "user" #E7F0FA {
  class User <<JPA Entity>> {
    +id: Long
    +username: String
    +password: String
    +fullName: String
    +email: String
    +documentNumber: String
    +phone: String
    +birthDate: LocalDate
    +role: Role
    +active: boolean
    +doctorId: Long
  }
  enum Role {
    SCHEDULER
    PATIENT
    DOCTOR
    ADMINISTRATOR
  }
  interface UserRepository <<JpaRepository>> {
    +findByUsernameIgnoreCase(username)
    +findByEmailIgnoreCase(email)
    +findByDocumentNumber(documentNumber)
  }
  class LoginUseCase {
    +execute(request): AuthenticatedUser
  }
  class RegisterUserUseCase {
    +execute(request): User
  }
  class RegistrationRules <<utility>> {
    +validate(request, today): Map
    +toPublicRole(value): Role
  }
  class AuthenticatedUser <<record>> {
    +id: Long
    +username: String
    +fullName: String
    +role: String
    +doctorId: Long
    +email: String
    +phone: String
  }
  User --> Role
  UserRepository ..> User
  LoginUseCase --> UserRepository : depende de JPA\n(no hay puerto)
  LoginUseCase ..> AuthenticatedUser
  RegisterUserUseCase --> UserRepository
  RegisterUserUseCase --> RegistrationRules
  RegisterUserUseCase ..> User
}

package "availability" #FFF6E5 {
  class Doctor <<JPA Entity>> {
    +id: Long
    +fullName: String
    +specialty: String
    +active: boolean
  }
  interface DoctorRepository <<JpaRepository>> {
    +findAll()
    +findById(id)
    +save(doctor)
  }
  class DoctorQueryService {
    +findAllActive(): List<DoctorResponseDTO>
  }
  DoctorRepository ..> Doctor
  DoctorQueryService --> DoctorRepository
}

package "appointment" #F8EAF6 {
  class Appointment <<JPA Entity>> {
    +id: Long
    +patientId: Long
    +doctorId: Long
    +appointmentDate: LocalDateTime
    +status: AppointmentStatus
    +whatsappNumber: String
    +notes: String
  }
  enum AppointmentStatus {
    PENDING
    CONFIRMED
    CANCELLED
    COMPLETED
    RESCHEDULED
  }
  interface AppointmentRepositoryPort {
    +findByDoctorAndDateRange(doctorId, start, end): List<Appointment>
  }
  class SearchAppointmentsByDoctorAndDateUseCase {
    +execute(doctorId, date): AppointmentSearchResultDTO
  }
  class AppointmentAssembler {
    +toResponse(appointment): AppointmentResponseDTO
  }
  interface AppointmentResponseEnricher {
    +enrich(appointment, base): AppointmentResponseDTO
  }
  class DefaultAppointmentResponseEnricher
  class ScheduleRules <<sin invocador>> #F8D0D0 {
    +timeRangeError(start, end): String
  }
  Appointment --> AppointmentStatus
  AppointmentRepositoryPort ..> Appointment
  SearchAppointmentsByDoctorAndDateUseCase --> AppointmentRepositoryPort
  SearchAppointmentsByDoctorAndDateUseCase --> DoctorQueryPort
  SearchAppointmentsByDoctorAndDateUseCase --> AppointmentAssembler
  AppointmentAssembler --> AppointmentResponseEnricher
  DefaultAppointmentResponseEnricher ..|> AppointmentResponseEnricher
  DefaultAppointmentResponseEnricher --> UserQueryPort
  DefaultAppointmentResponseEnricher --> DoctorQueryPort
}

package "piedrazul-app" #F4F4F4 {
  class RegisterAccountService {
    +register(request): User
  }
  class AuthTokenService {
    +issue(user): IssuedToken
    +resolve(token): Optional<IssuedToken>
  }
}

RegisterAccountService --> RegisterUserUseCase
RegisterAccountService --> DoctorRepository : si role == DOCTOR
RegisterAccountService --> UserRepository : guarda doctorId
AuthTokenService ..> AuthenticatedUser

note bottom of Doctor
  Doctor no tiene ventana en semanas, días de atención,
  franja horaria ni intervalo entre citas.
  Esos datos de HE-03 no están modelados.
end note

note bottom of Appointment
  patientId y doctorId no son asociaciones JPA.
  No hay método de dominio para crear, cancelar o reprogramar.
  El estado solo se lee en la consulta.
end note

@enduml
